# Copy to .env (git-ignored) for `pnpm dev`. The server's dev script loads it.
# With `pnpm dev:fake`, a FakeNode listens on 127.0.0.1:4403.
MESHTERM_NODE_HOST=127.0.0.1
MESHTERM_NODE_PORT=4403
MESHTERM_HTTP_PORT=8080
# Relative to apps/server; this lands in the git-ignored /data at the repo root.
MESHTERM_DATA_DIR=../../data
MESHTERM_LOG_LEVEL=info
# Sign-in is on by default; turn it off for development if you like.
# MESHTERM_AUTH=none
# Poll /data/themes for theme edits (network shares where file events are unreliable).
# MESHTERM_THEMES_POLL=1
